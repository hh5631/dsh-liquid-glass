{
  "name": "dsh-liquid-glass",
  "version": "1.0.1",
  "description": "DSH Web 的独立液态玻璃主题，内置原有玻璃配置。",
  "repository": { "type": "git", "url": "git+https://github.com/hh5631/dsh-liquid-glass.git" },
  "homepage": "https://github.com/hh5631/dsh-liquid-glass#readme",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check lib/client.js",
    "test": "node scripts/verify.mjs"
  },
  "files": ["lib", "scripts", "cordis.patch.yml", "README.md"],
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0-0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-slots"],
      "immediately": true
    }
  },
  "license": "MIT"
}
